{
  "name": "tanstarter-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run -r test && vp run -r build",
    "dev": "turbo run dev --filter=@repo/web --filter=@repo/backend",
    "dev:web": "vp run web#dev",
    "dev:convex": "vp run convex#dev",
    "start": "vp run web#start",
    "prepare": "vp config",
    "build": "vp run web#build"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "turbo": "^2.11.10",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0",
    "vite-plus": "1.6.0",
    "typescript": "^7.0.2",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tabler/icons-react": "^3.51.0",
    "@base-ui/react": "^1.9.0",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.23.0",
    "oxc-transform-react": "0.158.0",
    "convex": "^1.49.0",
    "clsx": "2.1.1",
    "tailwind-merge": "^3.7.0",
    "class-variance-authority": "0.7.1",
    "framer-motion": "^14.12.0",
    "goey-toast": "^0.6.0"
  }
}